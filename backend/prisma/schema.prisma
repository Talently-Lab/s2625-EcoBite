generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "analytics"]
}

/// Nivel de acceso asociado al tipo de usuario
enum NivelAcceso {
  propio
  restaurante
  global
  delivery

  @@schema("public")
}

/// Estado operativo del restaurante
enum EstadoRestaurante {
  activo
  inactivo

  @@schema("public")
}

/// Estado actual de un pedido
enum EstadoPedido {
  pendiente
  confirmado
  preparando
  listo
  en_transito
  entregado
  completado

  @@schema("public")
}

/// Estado actual del envío
enum EstadoEnvio {
  pendiente
  en_transito
  entregado

  @@schema("public")
}

/// Categorias de comida por los restaurantes
enum CategoriaComida {
  vegano
  vegetariano
  sin_tacc
  comida_saludable
  comida_rapida

  @@schema("public")
}

/// Catálogo que define los roles de usuario y su nivel de acceso al sistema
model TipoUsuario {
  id          String      @id @default(uuid()) @db.Uuid
  nombreRol   String      @unique @map("nombre_rol") @db.VarChar(100)
  nivelAcceso NivelAcceso @map("nivel_acceso")

  usuarios Usuario[]

  @@map("tipo_usuario")
  @@schema("public")
}

/// Almacena la información principal de los usuarios del sistema
model Usuario {
  id         String  @id @default(uuid()) @db.Uuid
  email      String  @unique @db.VarChar(200)
  nombre     String  @db.VarChar(200)
  contrasena String  @map("contraseña") @db.VarChar(255)
  imagenUri  String? @map("imagen_url") @db.VarChar(500)
  activo     Boolean @default(true)

  tipoUsuarioId String  @map("tipo_usuario_id") @db.Uuid
  restauranteId String? @map("restaurante_id") @db.Uuid

  tipoUsuario TipoUsuario  @relation(fields: [tipoUsuarioId], references: [id])
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id])

  delivery Delivery?
  pedidos  Pedido[]

  @@map("usuario")
  @@schema("public")
}

/// Catalogo de los tipos de transporte disponibles para los deliveries
model TipoTransporte {
  id          String @id @default(uuid()) @db.Uuid
  descripcion String @unique @db.VarChar(20)

  deliveries Delivery[]

  @@map("tipotransporte")
  @@schema("public")
}

/// Registra los deliveries y su tipo de transporte asociado
model Delivery {
  id               String @id @default(uuid()) @db.Uuid
  usuarioId        String @unique @map("usuario_id") @db.Uuid
  tipoTransporteId String @map("tipo_transporte_id") @db.Uuid

  usuario              Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipoTransporte       TipoTransporte        @relation(fields: [tipoTransporteId], references: [id])
  deliveryRestaurantes DeliveryRestaurante[]
  envios               Envio[]

  @@map("delivery")
  @@schema("public")
}

/// Registra la información de los restaurantes de la plataforma
model Restaurante {
  id        String  @id @default(uuid()) @db.Uuid
  nombre    String  @db.VarChar(200)
  email     String  @unique @db.VarChar(200)
  imagenUrl String? @map("imagen_url") @db.VarChar(500)

  domicilio String            @db.VarChar(200)
  latitude  Decimal           @db.Decimal(10, 7)
  longitude Decimal           @db.Decimal(10, 7)
  estado    EstadoRestaurante @default(activo)

  categoriaComida CategoriaComida @map("categoria_comida")

  usuarios             Usuario[]
  platos               Plato[]
  pedidos              Pedido[]
  envios               Envio[]
  deliveryRestaurantes DeliveryRestaurante[]

  @@map("restaurante")
  @@schema("public")
}

/// Registra la relación entre un delivery y los restaurantes a los que esta asociado
model DeliveryRestaurante {
  id            String @id @default(uuid()) @db.Uuid
  deliveryId    String @map("delivery_id") @db.Uuid
  restauranteId String @map("restaurante_id") @db.Uuid

  delivery    Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, restauranteId])
  @@map("delivery_restaurante")
  @@schema("public")
}

/// Registra los platos ofrecidos por los restaurantes y sus recipientes para el cálculo del impacto ambiental
model Plato {
  id            String  @id @default(uuid()) @db.Uuid
  restauranteId String  @map("restaurante_id") @db.Uuid
  nombre        String  @db.VarChar(200)
  imagenUrl     String? @map("imagen_url") @db.VarChar(500)
  precio        Decimal @db.Decimal(10, 2)
  activo        Boolean @default(true)

  cantidadVasos      Int? @default(0) @map("cantidad_vasos")
  cantidadPlatos     Int? @default(0) @map("cantidad_platos")
  cantidadCubiertos  Int? @default(0) @map("cantidad_cubiertos")
  cantidadRecipiente Int? @default(0) @map("cantidad_recipiente")

  restaurante Restaurante  @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  itemsPedido ItemPedido[]

  @@map("plato")
  @@schema("public")
}

/// Regitra los pedidos realizados por los usuarios a los restaurantes
model Pedido {
  id            String       @id @default(uuid()) @db.Uuid
  usuarioId     String       @map("usuario_id") @db.Uuid
  restauranteId String       @map("restaurante_id") @db.Uuid
  fecha         DateTime     @default(now())
  estado        EstadoPedido @default(pendiente)
  montoTotal    Decimal      @default(0.00) @map("monto_total") @db.Decimal(10, 2)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  restaurante Restaurante  @relation(fields: [restauranteId], references: [id])
  items       ItemPedido[]
  envio       Envio?

  @@index([fecha, estado], map: "idx_pedido_fecha_estado")
  @@map("pedido")
  @@schema("public")
}

/// Detalla los platos incluidos dentro de un pedido
model ItemPedido {
  id                 String  @id @default(uuid()) @db.Uuid
  pedidoId           String  @map("pedido_id") @db.Uuid
  platoId            String  @map("plato_id") @db.Uuid
  cantidad           Int
  precioUnitario     Decimal @map("precio_unitario") @db.Decimal(10, 2)
  /// Cantidades por unidad del plato al crear el pedido.
  /// NULL indica que no se dispone del dato histórico.
  cantidadVasos      Int?    @map("cantidad_vasos")
  cantidadPlatos     Int?    @map("cantidad_platos")
  cantidadCubiertos  Int?    @map("cantidad_cubiertos")
  cantidadRecipiente Int?    @map("cantidad_recipiente")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato  Plato  @relation(fields: [platoId], references: [id])

  @@map("itempedido")
  @@schema("public")
}

/// Representa el envío de un pedido y su asignación a un delivery
model Envio {
  id               String      @id @default(uuid()) @db.Uuid
  pedidoId         String      @unique @map("pedido_id") @db.Uuid
  fechaEnvio       DateTime    @default(now()) @map("fecha_envio")
  fechaAceptacion  DateTime?   @map("fecha_aceptacion") @db.Timestamptz(3)
  fechaEntrega     DateTime?   @map("fecha_entrega") @db.Timestamptz(3)
  deliveryId       String?     @map("delivery_id") @db.Uuid
  distanciaKm      Decimal     @default(1.50) @map("distancia_km") @db.Decimal(5, 2)
  restauranteId    String      @map("restaurante_id") @db.Uuid
  domicilioDestino String      @map("domicilio_destino") @db.VarChar(500)
  estado           EstadoEnvio @default(pendiente)

  pedido      Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  delivery    Delivery?   @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  restaurante Restaurante @relation(fields: [restauranteId], references: [id])

  @@index([fechaEnvio, deliveryId], map: "idx_envio_fecha_delivery")
  @@map("envio")
  @@schema("public")
}

/// Eventos del modulo de registro
model Evento {
  id             String   @id @default(uuid()) @db.Uuid
  nombreEvento   String   @map("nombre_evento") @db.VarChar(100)
  rolUsuario     String   @map("rol_usuario") @db.VarChar(100)
  usuarioId      String?  @map("usuario_id") @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  fechaCliente   DateTime @map("fecha_cliente") @db.Timestamptz(3)
  fechaRecepcion DateTime @default(now()) @map("fecha_recepcion") @db.Timestamptz(3)
  propiedades    Json     @default("{}") @db.JsonB

  @@index([nombreEvento, fechaRecepcion])
  @@index([sessionId])
  @@map("eventos")
  @@schema("analytics")
}
